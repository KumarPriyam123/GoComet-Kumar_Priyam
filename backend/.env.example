PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:15432/rfq
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:15432/rfq_test

# Used for date-only rules such as "quote validity must not be in the past"
APP_TIMEZONE=Asia/Kolkata

# How often the background job closes finished auctions
CLOSE_JOB_INTERVAL_MS=5000
